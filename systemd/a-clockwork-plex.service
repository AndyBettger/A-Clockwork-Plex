[Unit]
Description=A Clockwork Plex dashboard
After=network-online.target
Wants=network-online.target

[Service]
# Template values below are replaced by the guarded dashboard installer before
# this unit is installed. They are deliberately generic: the repository is not
# tied to any particular Raspberry Pi username or home directory.
Type=simple
User=ACP_PROJECT_USER
Group=ACP_PROJECT_USER
WorkingDirectory=/ACP_PROJECT_DIR
EnvironmentFile=-/etc/default/a-clockwork-plex-weather
ExecStart=/ACP_PROJECT_DIR/venv/bin/python /ACP_PROJECT_DIR/app/runner.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
