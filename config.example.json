{
  "dashboard": {
    "host": "0.0.0.0",
    "port": 8088,
    "default_mode": "clock",
    "startup_mode": "clock",
    "idle_return_mode": "clock",
    "clock_format": "24h",
    "idle_timeout_seconds": 180,
    "transition_style": "grow-fade",
    "transition_duration_ms": 300,
    "night_dim_enabled": false,
    "night_dim_start": "22:00",
    "night_dim_end": "07:00",
    "night_dim_level_percent": 18,
    "night_dim_active_level_percent": 35,
    "night_dim_wake_seconds": 30,
    "night_clock_mode": true,
    "night_burn_in_shift": true,
    "night_dim_style": "classic",
    "night_dim_active_style": "same"
  },
  "plexamp": {
    "url": "http://localhost:32500",
    "pause_url": "http://localhost:32500/player/playback/pause",
    "service_name": "plexamp.service"
  },
  "airplay": {
    "display_name": "Bedroom Plexamp",
    "default_volume_percent": 60,
    "apply_default_volume_on_start": true,
    "pause_hold_seconds": 600
  },
  "display": {
    "x_display": ":0",
    "xauthority": "/home/andy/.Xauthority",
    "browser_command": "chromium-browser",
    "dashboard_url": "http://localhost:8088",
    "airplay_url": "http://localhost:8088/airplay",
    "clock_url": "http://localhost:8088/clock",
    "weather_url": "http://localhost:8088/weather",
    "plexamp_url": "http://localhost:32500"
  },
  "weather": {
    "provider": "ecowitt_push",
    "display_units": "metric",
    "station_name": "Weather or Not",
    "reporting_station_name": "Weather Station Name",
    "auto_refresh_seconds": 60,
    "units": {
      "temperature": "c",
      "pressure": "hpa",
      "rain": "mm",
      "wind": "mph"
    },
    "forecast": {
      "enabled": false,
      "provider": "open_meteo",
      "latitude": null,
      "longitude": null,
      "timezone": "Europe/London",
      "forecast_days": 7,
      "refresh_minutes": 30,
      "request_timeout_seconds": 8,
      "stale_after_hours": 6
    },
    "clock_cards": [
      "outdoor_temp",
      "humidity",
      "wind_speed",
      "wind_gust",
      "daily_rain",
      "pressure"
    ]
  },
  "alarm": {
    "enabled": false,
    "default_time": "11:00",
    "snooze_minutes": 8,
    "schema_version": 2,
    "defaults": {
      "snooze_minutes": 8,
      "ring_minutes": 3,
      "occurrence_expiry_minutes": 120,
      "tone_id": "classic-klaxon",
      "fallback_tone_id": "emergency-buzzer",
      "source_type": "tone"
    },
    "alarms": [
      {
        "id": "default-alarm",
        "enabled": false,
        "label": "Default alarm",
        "time": "11:00",
        "days": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri",
          "sat",
          "sun"
        ],
        "source": {
          "type": "tone",
          "tone_id": "classic-klaxon",
          "fallback_tone_id": "emergency-buzzer"
        },
        "volume": {
          "start_percent": 30,
          "target_percent": 70,
          "fade_seconds": 20
        },
        "snooze_minutes": 8,
        "ring_minutes": 3,
        "occurrence_expiry_minutes": 120
      }
    ]
  },
  "alarm_audio": {
    "master_enabled": false,
    "scheduled_enabled": false,
    "shared_mixer_enabled": false,
    "alsa_device": "default",
    "hardware_device": "hw:0,0",
    "test_duration_seconds": 5,
    "tone_frequency_hz": 880,
    "tone_volume_percent": 35
  }
}
