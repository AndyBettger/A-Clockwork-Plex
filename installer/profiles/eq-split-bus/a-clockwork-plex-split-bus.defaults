# A Clockwork Plex EQ-capable audio profile.
AUDIO_PROFILE=eq-split-bus
PROJECT_USER=andy
DAC_CARD=Pro
DAC_DEVICE=0
LOOPBACK_INDEX=7
LOOPBACK_ID=ACP_Loopback
SAMPLE_RATE=44100
FORMAT=S16_LE
PERIOD_SIZE=1024
BUFFER_SIZE=8192
CHUNKSIZE=1024
TARGET_LEVEL=2048
CAMILLADSP_VERSION=4.1.3
CAMILLADSP_SHA256=e04c7a6603e9482bab33c1e18afc41d3c07410b54ba9c246eda69f7e9cbaedfa
ACTIVE_ALSA_CONFIG=/etc/alsa/conf.d/99-a-clockwork-plex-shared.conf
SPLIT_ROUTE=/etc/a-clockwork-plex/audio-routes/split-bus.conf
DIRECT_FAILBACK_ROUTE=/etc/a-clockwork-plex/audio-routes/direct-alarm-bypass.conf
CAMILLADSP_BINARY=/usr/local/lib/a-clockwork-plex/camilladsp-4.1.3/camilladsp
CAMILLADSP_CONFIG=/etc/a-clockwork-plex/camilladsp-split-bus.yml
EQ_RUNTIME_ROOT=/usr/local/lib/a-clockwork-plex/audio-eq
STATE_DIR=/var/lib/a-clockwork-plex/split-bus
EQ_STATE_PATH=/var/lib/a-clockwork-plex/split-bus/master-eq.json
ROUTE_STATE_PATH=/var/lib/a-clockwork-plex/split-bus/route-state.json
INSTALLED_MARKER=/var/lib/a-clockwork-plex/split-bus/installed
AUDIO_LOCK_PATH=/run/lock/a-clockwork-plex-audio-route.lock
CAMILLADSP_SERVICE=a-clockwork-plex-camilladsp.service
ROUTE_SERVICE=a-clockwork-plex-audio-route.service
FAILBACK_SERVICE=a-clockwork-plex-audio-failback.service
PLEXAMP_SERVICE=plexamp.service
AIRPLAY_SERVICE=shairport-sync.service
DASHBOARD_SERVICE=a-clockwork-plex.service
DAC_HW_PARAMS=/proc/asound/Pro/pcm0p/sub0/hw_params
ALSA_BASE_CONFIG=/usr/share/alsa/alsa.conf
